@@ -0,0 +1,158 @@
+//! User model choices captured with a request. Credentials and endpoints are
+//! deliberately absent: the authority resolves these identities in its catalog.
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeMap;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ModelRole {
+    #[default]
+    Main,
+    Browser,
+    Coding,
+    Quick,
+    Review,
+    Decisions,
+}
+
+impl ModelRole {
+    pub const ALL: [Self; 6] = [
+        Self::Main,
+        Self::Browser,
+        Self::Coding,
+        Self::Quick,
+        Self::Review,
+        Self::Decisions,
+    ];
+    pub const fn label(self) -> &'static str {
+        match self {
+            Self::Main => "Main assistant",
+            Self::Browser => "Browser work",
+            Self::Coding => "Coding",
+            Self::Quick => "Quick tasks",
+            Self::Review => "Review",
+            Self::Decisions => "Typed decisions",
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ModelReference {
+    pub provider: String,
+    pub model: String,
+}
+impl ModelReference {
+    pub fn validate(&self) -> Result<(), &'static str> {
+        if [&self.provider, &self.model].iter().any(|s| {
+            s.is_empty()
+                || s.len() > 256
+                || s.trim() != s.as_str()
+                || s.chars().any(char::is_control)
+        }) {
+            return Err("A model choice requires a provider and model id, each at most 256 bytes");
+        }
+        Ok(())
+    }
+    pub fn parse(value: &str) -> Result<Self, &'static str> {
+        let (provider, model) = value
+            .trim()
+            .split_once('/')
+            .ok_or("Use provider/model-id")?;
+        let reference = Self {
+            provider: provider.into(),
+            model: model.into(),
+        };
+        reference.validate()?;
+        Ok(reference)
+    }
+    pub fn name(&self) -> String {
+        format!("{}/{}", self.provider, self.model)
+    }
+}
+
+/// Select a supported authority-owned Jev secret source, never a raw key.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum DecisionCredential {
+    #[default]
+    AuthorityDefault,
+    Keychain,
+    Environment,
+}
+
+/// Omitted roles inherit Main. An omitted Main uses the authority's Automatic
+/// resolution. Decisions are separate and never implicitly become a chat model.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct ModelAssignments {
+    pub overrides: BTreeMap<ModelRole, ModelReference>,
+    /// A failed explicit binding may use Automatic only when the user opted in.
+    pub allow_fallback: bool,
+    /// Explicit compatible implementation if the typed-decision provider fails.
+    pub decision_fallback: Option<ModelReference>,
+    pub decision_credential: DecisionCredential,
+}
+impl ModelAssignments {
+    pub fn requested(&self, role: ModelRole) -> Option<&ModelReference> {
+        self.overrides.get(&role).or_else(|| {
+            (role != ModelRole::Decisions)
+                .then(|| self.overrides.get(&ModelRole::Main))
+                .flatten()
+        })
+    }
+    pub fn validate(&self) -> Result<(), &'static str> {
+        for model in self.overrides.values().chain(self.decision_fallback.iter()) {
+            model.validate()?;
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct ModelRoutingRequest {
+    pub role: ModelRole,
+    pub assignments: ModelAssignments,
+}
+
+/// Authority-owned routing evidence. `bound` is the model admitted for execution;
+/// it is not a claim about a provider's undisclosed internal model/version.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ModelRoutingReceipt {
+    pub role: ModelRole,
+    pub requested: Option<ModelReference>,
+    pub bound: ModelReference,
+    pub source: String,
+    pub fallback_reason: Option<String>,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn role_override_wins_and_decisions_do_not_inherit_chat() {
+        let mut choices = ModelAssignments::default();
+        choices.overrides.insert(
+            ModelRole::Main,
+            ModelReference::parse("provider/main").unwrap(),
+        );
+        choices.overrides.insert(
+            ModelRole::Coding,
+            ModelReference::parse("provider/code/version").unwrap(),
+        );
+        assert_eq!(choices.requested(ModelRole::Browser).unwrap().model, "main");
+        assert_eq!(
+            choices.requested(ModelRole::Coding).unwrap().model,
+            "code/version"
+        );
+        assert!(choices.requested(ModelRole::Decisions).is_none());
+        assert!(!choices.allow_fallback);
+        assert!(serde_json::from_str::<ModelReference>(
+            r#"{"provider":"x","model":"y","apiKey":"secret"}"#
+        )
+        .is_err());
+        assert!(ModelReference::parse("provider/").is_err());
+    }
+}
