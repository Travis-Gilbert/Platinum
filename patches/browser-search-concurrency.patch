+/// A scoped search snapshot. Execute without holding the browser store lock.
+/// Dropping it cancels unstarted work; no session is persisted until finish.
+pub struct PreparedBrowserSearch {
+    service: RustyWebQueryService,
+    request: QueryRequest,
+    options: ProgrammableQueryOptions,
+    invalid_embedder: bool,
+    tenant: String,
+    session_id: String,
+    run_id: String,
+    owner: Arc<()>,
+    warm: Arc<PageWarmIndex>,
+    temporary: Option<Arc<tempfile::TempDir>>,
+}
+
+/// An executed query bound to its originating browser store, awaiting retention.
+pub struct CompletedBrowserSearch {
+    session: SearchSession,
+    owner: Arc<()>,
+    _warm: Arc<PageWarmIndex>,
+    _temporary: Option<Arc<tempfile::TempDir>>,
+}
+
+impl PreparedBrowserSearch {
+    /// Runs provider acquisition, reranking and optional synthesis against the
+    /// captured graph/profile/index. Concurrent captures affect the next query.
+    pub async fn execute(
+        self,
+        providers: &[Arc<dyn SearchProvider>],
+    ) -> GraphStoreResult<CompletedBrowserSearch> {
+        let mut response = self.service.query(providers, self.request.clone()).await;
+        if self.invalid_embedder {
+            response
+                .receipt
+                .degraded
+                .push("dense_query_embedder_configuration_invalid".into());
+        }
+        let mut session = SearchSession::new(
+            self.session_id,
+            self.run_id,
+            self.tenant.clone(),
+            self.options.retention,
+            self.request,
+            response,
+        )?;
+        if session
+            .response
+            .receipt
+            .search_plan
+            .as_ref()
+            .is_some_and(|plan| plan.synthesis != rustyred_web::query::SynthesisPolicy::None)
+        {
+            let configured = std::env::var_os("THEOREM_WEB_SYNTHESIS_CONFIG")
+                .ok_or_else(|| {
+                    GraphStoreError::new(
+                        "synthesis_model_unavailable",
+                        "configure THEOREM_WEB_SYNTHESIS_CONFIG",
+                    )
+                })
+                .and_then(|path| {
+                    agent::config::AgentdConfig::load(PathBuf::from(path)).map_err(|_| {
+                        GraphStoreError::new(
+                            "synthesis_model_configuration_invalid",
+                            "synthesis config could not be loaded",
+                        )
+                    })
+                })
+                .and_then(|config| {
+                    agent::provider::evidence_synthesis::HttpEvidenceSynthesizer::new(
+                        config.model,
+                        self.tenant.clone(),
+                        self.options.allow_private_evidence,
+                    )
+                });
+            let outcome = match configured {
+                Ok(synthesizer) => session.synthesize(&synthesizer).await,
+                Err(error) => Err(error),
+            };
+            if let Err(error) = outcome {
+                session.response.receipt.degraded.push(error.code);
+            }
+        }
+        session.canvas_layout_ref = Some(search_layout_ref(&session)?);
+        Ok(CompletedBrowserSearch {
+            session,
+            owner: self.owner,
+            _warm: self.warm,
+            _temporary: self.temporary,
+        })
+    }
+}
