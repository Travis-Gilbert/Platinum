#!/usr/bin/env bash
# Prepares a Platinum checkout to build.
#
# Platinum's RustyWeb and notes crates are path dependencies under deps/, a
# read-only checkout of Theorem at a pinned commit of claude/notes-foundations,
# which builds on claude/rustyweb-synthesis-on-request and
# codex/rustyweb-programmable-web-2. The small detached-search API patch is
# applied idempotently without replacing local work.
# deps/ and the Cargo target directory can live on another disk: a Servo build
# needs about 25 GB.
#
#   FRAME_THEOREM_REPO  a local Theorem clone (default: ../Theorem, else a fresh clone)
#   FRAME_DEPS_DIR      where deps/ points (default: ./deps itself)
#   FRAME_TARGET_DIR    Cargo's target directory (default: ./target)
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
theorem_rev="7eb1ba024b6ccab8146f7857535dcdc6334eb39b"
theorem_branch="claude/notes-foundations"
theorem_url="https://github.com/Travis-Gilbert/Theorem.git"

deps_dir="${FRAME_DEPS_DIR:-$root/deps}"
checkout="$deps_dir/theorem-consolidated"
mkdir -p "$deps_dir"
if [[ "$deps_dir" != "$root/deps" ]]; then
  if [[ -e "$root/deps" && ! -L "$root/deps" ]]; then
    echo "deps/ exists and is not a link; move it or unset FRAME_DEPS_DIR" >&2
    exit 1
  fi
  ln -sfn "$deps_dir" "$root/deps"
fi

if [[ ! -d "$checkout" ]]; then
  repo="${FRAME_THEOREM_REPO:-$root/../Theorem}"
  if [[ -d "$repo/.git" ]]; then
    git -C "$repo" fetch origin "$theorem_branch"
    git -C "$repo" worktree add --detach "$checkout" "$theorem_rev"
  else
    git clone --branch "$theorem_branch" "$theorem_url" "$checkout"
    git -C "$checkout" checkout --detach "$theorem_rev"
  fi
fi
actual="$(git -C "$checkout" rev-parse HEAD)"
if [[ "$actual" != "$theorem_rev" ]]; then
  echo "deps/theorem-consolidated is at $actual, Platinum pins $theorem_rev" >&2
  exit 1
fi

patch="$root/patches/browser-search-concurrency.patch"
if git -C "$checkout" apply --reverse --check "$patch" 2>/dev/null; then
  : # Already applied.
elif git -C "$checkout" apply --check "$patch"; then
  git -C "$checkout" apply "$patch"
else
  echo "Search patch conflicts with local dependency changes; leaving them untouched." >&2
  exit 1
fi

if [[ -n "${FRAME_TARGET_DIR:-}" ]]; then
  mkdir -p "$root/.cargo"
  cat > "$root/.cargo/config.toml" <<EOF
# Machine-local; written by script/bootstrap. A Servo build needs ~25 GB.
[build]
target-dir = "$FRAME_TARGET_DIR"
EOF
fi

echo "Ready: cargo run"
