+    #[test]
+    fn prepared_search_keeps_old_generation_and_cannot_finish_in_other_store() {
+        let mut browser = crate::memory_browser_session("profile");
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap();
+        let old = browser
+            .prepare_search_with_query_embedder("tides", Default::default(), Ok(None))
+            .unwrap();
+        let old_root = old.warm.root_path().to_path_buf();
+        browser
+            .capture_loaded_page_with_policy(
+                crate::LoadedPage::html(
+                    "https://example.test/tides",
+                    "<title>Tides</title><p>The moon drives tides.</p>",
+                ),
+                &crate::BrowserCapturePolicy::default(),
+            )
+            .unwrap();
+        let new = browser
+            .prepare_search_with_query_embedder("tides", Default::default(), Ok(None))
+            .unwrap();
+        assert_ne!(old_root, new.warm.root_path());
+        assert!(
+            old_root.exists(),
+            "an executing query still owns the old index"
+        );
+        let second = runtime.block_on(new.execute(&[])).unwrap();
+        let second = browser.finish_programmable_search(second).unwrap();
+        assert!(!second.response.hits.is_empty());
+        let first = runtime.block_on(old.execute(&[])).unwrap();
+        let first = browser.finish_programmable_search(first).unwrap();
+        assert!(
+            first.response.hits.is_empty(),
+            "query reads its original snapshot"
+        );
+        assert_ne!(first.run_id, second.run_id);
+        assert_eq!(browser.search.sessions.len(), 2);
+        browser.prune_search_generations();
+        assert!(!old_root.exists(), "unused generations are reclaimed");
+
+        let pending = browser
+            .prepare_search_with_query_embedder("tides", Default::default(), Ok(None))
+            .unwrap();
+        let completed = runtime.block_on(pending.execute(&[])).unwrap();
+        let mut other = crate::memory_browser_session("profile");
+        assert!(
+            other.finish_programmable_search(completed).is_err(),
+            "even a matching tenant label does not share a store"
+        );
+        assert!(other.search.sessions.is_empty());
+    }
