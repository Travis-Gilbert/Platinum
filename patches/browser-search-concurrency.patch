+    fn prune_search_generations(&mut self) {
+        self.search.leases.retain(|lease| lease.strong_count() > 0);
+        if let Some(root) = &self.search.root {
+            let held: Vec<_> = self
+                .search
+                .leases
+                .iter()
+                .filter_map(|lease| lease.upgrade())
+                .collect();
+            let mut keep: Vec<_> = held.iter().map(|index| index.root_path()).collect();
+            if let Some(warm) = &self.search.warm {
+                keep.push(warm.root_path());
             }
+            rustyred_web::prune_warm_generation_dirs(root, &keep).ok();
