#!/usr/bin/env bash
# Prepares a Platinum checkout to build.
#
# Platinum's RustyWeb and notes crates are path dependencies under deps/, a
# read-only checkout of Theorem at a pinned commit of
# claude/agent-runtime-record-view. That branch puts the chat runtime's
# record_view module behind a feature, on claude/browser-search-concurrency,
# which adds detached browser searches to claude/notes-foundations, which builds on
# claude/rustyweb-synthesis-on-request and codex/rustyweb-programmable-web-2.
# deps/ and the Cargo target directory can live on another disk: a Servo build
# needs about 25 GB.
#
#   FRAME_THEOREM_REPO  a local Theorem clone (default: ../Theorem, else a fresh clone)
#   FRAME_DEPS_DIR      where deps/ points (default: ./deps itself)
#   FRAME_TARGET_DIR    Cargo's target directory (default: ./target)
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
theorem_rev="08495b15879a7bc2449d43c49530f549268d05fc"
theorem_branch="claude/agent-runtime-record-view"
theorem_url="https://github.com/Travis-Gilbert/Theorem.git"

deps_dir="${FRAME_DEPS_DIR:-$root/deps}"
checkout="$deps_dir/theorem-search"
mkdir -p "$deps_dir"
if [[ "$deps_dir" != "$root/deps" ]]; then
  if [[ -e "$root/deps" && ! -L "$root/deps" ]]; then
    echo "deps/ exists and is not a link; move it or unset FRAME_DEPS_DIR" >&2
    exit 1
  fi
  ln -sfn "$deps_dir" "$root/deps"
fi

if [[ ! -d "$checkout" ]]; then
  repo="${FRAME_THEOREM_REPO:-$root/../Theorem}"
  if [[ -d "$repo/.git" ]]; then
    git -C "$repo" fetch origin "$theorem_branch"
    git -C "$repo" worktree add --detach "$checkout" "$theorem_rev"
  else
    git clone --branch "$theorem_branch" "$theorem_url" "$checkout"
    git -C "$checkout" checkout --detach "$theorem_rev"
  fi
fi
actual="$(git -C "$checkout" rev-parse HEAD)"
if [[ "$actual" != "$theorem_rev" ]]; then
  echo "deps/theorem-search is at $actual, Platinum pins $theorem_rev" >&2
  exit 1
fi

# Companion client/authority changes stay reviewable in Platinum until their
# upstream revision is published. Never modify a shared or dirty dependency.
patch="$root/patches/theorem-model-routing.patch"
if ! git -C "$checkout" apply --reverse --check "$patch" >/dev/null 2>&1; then
  if [[ -L "$checkout" || -n "$(git -C "$checkout" status --porcelain)" ]]; then
    echo "Theorem routing patch needs a clean, isolated dependency checkout; preserving $checkout" >&2
    exit 1
  fi
  git -C "$checkout" apply --check "$patch"
  git -C "$checkout" apply "$patch"
fi

if [[ -n "${FRAME_TARGET_DIR:-}" ]]; then
  mkdir -p "$root/.cargo"
  cat > "$root/.cargo/config.toml" <<EOF
# Machine-local; written by script/bootstrap. A Servo build needs ~25 GB.
[build]
target-dir = "$FRAME_TARGET_DIR"
EOF
fi

echo "Ready: cargo run"
