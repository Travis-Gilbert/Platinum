+            embedder_proxy: embedder_proxy.clone(),
+            webview_id,
+            request_id,
+        })
+    }
+}
+
+impl Drop for RequestActivity {
+    fn drop(&mut self) {
+        self.embedder_proxy.send(NetToEmbedderMsg::RequestFinished(
+            self.webview_id,
+            self.request_id,
+        ));
+    }
+}
