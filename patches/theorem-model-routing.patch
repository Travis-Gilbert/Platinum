index 000000000..1ab07ea8f
--- /dev/null
+++ b/rustyredcore_THG/crates/rustyred-thg-server/src/typed_decisions.rs
@@ -0,0 +1,297 @@
+//! Authenticated typed-decision execution and durable graph receipts. Inserting
+//! the pending node atomically precedes disclosure/spend; an unknown outcome is
+//! never retried automatically, including after a server restart.
+use agent::config::{ModelConfig, ModelProvider};
+use agent::provider::decision::{self, CallError, Command};
+use rustyred_thg_core::NodeRecord;
+use rustyred_thg_mcp::{McpError, McpGraphBackend, ResolvedIdentity};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use theorem_surface_contracts::model_routing::ModelReference;
+
+fn hash(value: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(value))
+}
+
+pub(crate) fn execute(
+    backend: &mut impl McpGraphBackend,
+    identity: &ResolvedIdentity,
+    value: Value,
+) -> Result<Value, McpError> {
+    execute_with(
+        backend,
+        identity,
+        value,
+        model_config,
+        |_, request, credential, config| {
+            match config {
+                None => decision::jev_call(request, credential),
+                Some(config) => decision::emulation_call(request, config),
+            }
+            .and_then(|response| decision::answers(request, response).map_err(CallError::Rejected))
+        },
+    )
+}
+
+// Inject transport at the effect boundary so interruption tests exercise the
+// real graph writes and replay logic without a paid external request.
+fn execute_with<B: McpGraphBackend>(
+    backend: &mut B,
+    identity: &ResolvedIdentity,
+    value: Value,
+    resolve: impl Fn(&ModelReference) -> Result<Option<ModelConfig>, McpError>,
+    mut invoke: impl FnMut(
+        &mut B,
+        &decision::zephium_decision::DecisionRequest,
+        theorem_surface_contracts::model_routing::DecisionCredential,
+        Option<ModelConfig>,
+    ) -> Result<Value, CallError>,
+) -> Result<Value, McpError> {
+    let command: Command = serde_json::from_value(value)
+        .map_err(|_| McpError::invalid_params("invalid typed-decision command"))?;
+    let request = command.request().map_err(McpError::invalid_params)?;
+    // The source must exist in the admitted tenant, not merely be an arbitrary
+    // provenance string. The full observation used is retained in the receipt.
+    let source = backend
+        .get_node(&command.observation_ref)
+        .map_err(|_| McpError::internal("decision source unavailable"))?
+        .filter(|n| !n.tombstone)
+        .ok_or_else(|| McpError::invalid_params("decision observation node not found"))?;
+    let fingerprint = hash(
+        &serde_json::to_vec(
+            &json!({"request":request, "model":command.model, "fallback":command.fallback, "credential_policy":command.credential,
+        "observation_ref":command.observation_ref, "observation_version":source.version}),
+        )
+        .map_err(|_| McpError::invalid_params("invalid decision request"))?,
+    );
+    let id = format!(
+        "typed-decision:{}",
+        hash(
+            &serde_json::to_vec(&json!([
+                identity.tenant,
+                identity.principal.as_ref().map(|p| &p.principal_id),
+                command.operation_key
+            ]))
+            .unwrap()
+        )
+    );
+    if let Some(existing) = backend
+        .get_node(&id)
+        .map_err(|_| McpError::internal("decision receipt unavailable"))?
+    {
+        if existing.tombstone || existing.properties["fingerprint"] != fingerprint {
+            return Err(McpError::invalid_params(
+                "decision operation key already binds another observation",
+            ));
+        }
+        let mut receipt = existing.properties;
+        if receipt["state"] == "complete" {
+            // Graph state can be restored or edited. Replay never bypasses the
+            // typed-answer validator or returns unchecked option keys.
+            let usage = serde_json::from_value(receipt["result"]["usage"].clone())
+                .map_err(|_| McpError::internal("invalid stored decision usage"))?;
+            let encoded = serde_json::to_vec(&json!({"answers":receipt["result"]["answers"]}))
+                .map_err(|_| McpError::internal("invalid stored decision answers"))?;
+            let response = request.decode_emulation(&encoded, usage).map_err(|_| {
+                McpError::internal("stored decision no longer matches its question")
+            })?;
+            receipt["result"] =
+                decision::answers(&request, response).map_err(McpError::internal)?;
+        } else if receipt["state"] != "pending" && receipt["state"] != "failed" {
+            return Err(McpError::internal("invalid stored decision state"));
+        }
+        return Ok(receipt);
+    }
+    // Resolve both routes before a paid call. Catalog owns endpoint/key refs.
+    let primary = resolve(&command.model)?;
+    let fallback = command.fallback.as_ref().map(resolve).transpose()?;
+    let mut receipt = json!({"schema":"theorem.typed-decision.v1", "id":id, "state":"pending", "fingerprint":fingerprint,
+        "observation_ref":command.observation_ref, "observation_version":source.version,
+        "request":request, "requested":command.model, "fallback":command.fallback, "credential_policy":command.credential,
+        "principal":identity.principal.as_ref().map(|p| &p.principal_id),
+        "attempted":[command.model],
+        "authority":"validated evidence only; apply operations through normal admission"});
+    let created = backend
+        .insert_node_if_never_existed(NodeRecord::new(&id, ["TypedDecision"], receipt.clone()))
+        .map_err(|_| McpError::internal("cannot persist pending decision"))?;
+    if !created {
+        return Err(McpError::invalid_params(
+            "decision already pending; read its receipt before retrying",
+        ));
+    }
+    let mut actual = command.model.clone();
+    let result = match invoke(backend, &request, command.credential, primary) {
+        Err(reason) if reason.can_fallback() && command.fallback.is_some() => {
+            receipt["fallback_reason"] = json!(reason.code());
+            actual = command.fallback.clone().unwrap();
+            receipt["attempted"]
+                .as_array_mut()
+                .unwrap()
+                .push(json!(&actual));
+            // Persist the second attempt and why it was selected before any
+            // external call. Persistence failure must prevent dispatch.
+            backend
+                .upsert_node(NodeRecord::new(&id, ["TypedDecision"], receipt.clone()))
+                .map_err(|_| {
+                    McpError::internal("cannot persist fallback attempt; not dispatched")
+                })?;
+            invoke(backend, &request, command.credential, fallback.flatten())
+        }
+        result => result,
+    };
+    match result {
+        Ok(result) => {
+            receipt["actual"] = json!(actual);
+            receipt["state"] = json!("complete");
+            receipt["result"] = result;
+        }
+        Err(reason) => {
+            receipt["state"] = json!(if reason.is_unknown() {
+                "pending"
+            } else {
+                "failed"
+            });
+            receipt["error"] = json!(reason.code());
+        }
+    }
+    backend
+        .upsert_node(NodeRecord::new(&id, ["TypedDecision"], receipt.clone()))
+        .map_err(|_| {
+            McpError::internal(
+                "decision outcome could not be persisted; do not repeat the operation",
+            )
+        })?;
+    Ok(receipt)
+}
+
+fn model_config(model: &ModelReference) -> Result<Option<ModelConfig>, McpError> {
+    if *model == decision::jev() {
+        return Ok(None);
+    }
+    let binding = crate::chat_model_binding::resolve_requested(&model.provider, &model.model)
+        .map_err(|_| {
+            McpError::invalid_params(
+                "decision model or credential is not configured in the authority catalog",
+            )
+        })?
+        .binding;
+    if binding.provider.eq_ignore_ascii_case("rule") {
+        return Err(McpError::invalid_params(
+            "rule is not a typed-decision provider",
+        ));
+    }
+    Ok(Some(ModelConfig {
+        provider: ModelProvider::OpenAiCompatible,
+        provider_id: Some(binding.provider.clone()),
+        keychain_provider: Some(binding.provider),
+        model: binding.model,
+        api_key_env: binding.api_key_env,
+        base_url: binding.base_url.unwrap_or_default(),
+        ..ModelConfig::rule_default()
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rustyred_thg_core::InMemoryGraphStore;
+
+    fn fixture() -> (InMemoryGraphStore, ResolvedIdentity, Value, String) {
+        let mut store = InMemoryGraphStore::new();
+        McpGraphBackend::upsert_node(
+            &mut store,
+            NodeRecord::new("source", ["Observation"], json!({"text":"observed"})),
+        )
+        .unwrap();
+        let identity = ResolvedIdentity {
+            deployment_id: "test".into(),
+            tenant: "tenant".into(),
+            actor: None,
+            project_id: None,
+            project_slug: None,
+            resolution_path: "test".into(),
+            principal: None,
+            warnings: vec![],
+        };
+        let command = json!({"operation_key":"once", "observation_ref":"source", "state":{},
+            "questions":{"ok":{"type":"noul","instructions":"Is it present?"}},
+            "fallback":{"provider":"test","model":"fallback"}});
+        let id = format!(
+            "typed-decision:{}",
+            hash(&serde_json::to_vec(&json!(["tenant", null, "once"])).unwrap())
+        );
+        (store, identity, command, id)
+    }
+
+    #[test]
+    fn lost_reply_stays_pending_without_fallback_or_replay_dispatch() {
+        let (mut store, identity, command, id) = fixture();
+        let mut calls = 0;
+        let receipt = execute_with(
+            &mut store,
+            &identity,
+            command.clone(),
+            |_| Ok(None),
+            |store, _, _, _| {
+                calls += 1;
+                let pending = McpGraphBackend::get_node(store, &id).unwrap().unwrap();
+                assert_eq!(pending.properties["state"], "pending");
+                assert_eq!(pending.properties["attempted"].as_array().unwrap().len(), 1);
+                Err(CallError::UnknownOutcome("decision_unavailable"))
+            },
+        )
+        .unwrap();
+        assert_eq!(calls, 1);
+        assert_eq!(receipt["state"], "pending");
+        assert!(receipt.get("actual").is_none());
+        let replay = execute_with(
+            &mut store,
+            &identity,
+            command,
+            |_| panic!("must not resolve again"),
+            |_, _, _, _| panic!("must not dispatch again"),
+        )
+        .unwrap();
+        assert_eq!(receipt, replay);
+    }
+
+    #[test]
+    fn interrupted_fallback_keeps_its_attempt_and_reason() {
+        let (mut store, identity, command, id) = fixture();
+        let mut calls = 0;
+        let interrupted = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            execute_with(
+                &mut store,
+                &identity,
+                command.clone(),
+                |_| Ok(None),
+                |store, _, _, _| {
+                    calls += 1;
+                    if calls == 1 {
+                        return Err(CallError::NotDispatched("decision_credential_missing"));
+                    }
+                    let pending = McpGraphBackend::get_node(store, &id).unwrap().unwrap();
+                    assert_eq!(pending.properties["attempted"].as_array().unwrap().len(), 2);
+                    assert_eq!(
+                        pending.properties["fallback_reason"],
+                        "decision_credential_missing"
+                    );
+                    panic!("simulated interruption after dispatch");
+                },
+            )
+        }));
+        assert!(interrupted.is_err());
+        assert_eq!(calls, 2);
+        let replay = execute_with(
+            &mut store,
+            &identity,
+            command,
+            |_| panic!("must not resolve again"),
+            |_, _, _, _| panic!("must not dispatch again"),
+        )
+        .unwrap();
+        assert_eq!(replay["state"], "pending");
+        assert_eq!(replay["attempted"].as_array().unwrap().len(), 2);
+        assert_eq!(replay["fallback_reason"], "decision_credential_missing");
+    }
+}
