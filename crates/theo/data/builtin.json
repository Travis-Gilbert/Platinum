{"source":{"repository":"Travis-Gilbert/Theorem-UI","commit":"88043d3156d1a3bd993b2181d83c221b689eb9af"},"identity":{"width":100,"height":64,"grains":1200,"grain":1.6,"hue":205,"chroma":0.11,"lightness":0.9,"features":[{"id":"eye.left","side":"left"},{"id":"eye.right","side":"right"}]},"featureParams":{"x":{"min":-46,"max":46,"rest":20,"note":"Distance from the centre line, outward; a centre feature uses it as plain x."},"y":{"min":-28,"max":28,"rest":0,"note":"Height; negative is up."},"w":{"min":0.5,"max":30,"rest":12,"note":"Half width."},"h":{"min":0.5,"max":28,"rest":13,"note":"Half height."},"round":{"min":0.7,"max":10,"rest":4,"note":"Corner exponent: 1 a diamond, 2 an ellipse, 4 and up a rounded box."},"r0":{"min":0.2,"max":1.8,"rest":1,"note":"Radial gain, outer side."},"r1":{"min":0.2,"max":1.8,"rest":1,"note":"Radial gain, outer lower corner."},"r2":{"min":0.2,"max":1.8,"rest":1,"note":"Radial gain, bottom."},"r3":{"min":0.2,"max":1.8,"rest":1,"note":"Radial gain, inner lower corner."},"r4":{"min":0.2,"max":1.8,"rest":1,"note":"Radial gain, inner side."},"r5":{"min":0.2,"max":1.8,"rest":1,"note":"Radial gain, inner upper corner."},"r6":{"min":0.2,"max":1.8,"rest":1,"note":"Radial gain, top."},"r7":{"min":0.2,"max":1.8,"rest":1,"note":"Radial gain, outer upper corner."},"lid":{"min":0,"max":1,"rest":0,"note":"Upper lid: 0 open, 1 shut. Shut matter gathers on the lid line."},"lidTilt":{"min":-1,"max":1,"rest":0,"note":"Upper lid slant: positive drops the inner end (a glare), negative the outer (worry)."},"lidBow":{"min":-1,"max":1,"rest":0,"note":"Upper lid curve: positive sags in the middle, negative arches."},"low":{"min":0,"max":1,"rest":0,"note":"Lower lid: 0 open, 1 shut."},"lowTilt":{"min":-1,"max":1,"rest":0,"note":"Lower lid slant: positive raises the inner end."},"lowBow":{"min":-1,"max":1,"rest":0,"note":"Lower lid curve: positive rises in the middle (a smiling eye)."},"hollow":{"min":0,"max":0.95,"rest":0,"note":"Empty middle: 0 filled, toward 1 a ring."},"rings":{"min":0,"max":6,"rest":0,"note":"Its matter gathered into this many rings, from the middle out: 0 filled, 3 a loudspeaker."},"slats":{"min":0,"max":9,"rest":0,"note":"Its matter gathered into this many bars across: 0 filled, 5 a grille."},"mesh":{"min":0,"max":12,"rest":0,"note":"Its matter gathered into dots, this many across the middle, inside a rim: 0 filled, 10 a speaker cover."},"globe":{"min":0,"max":12,"rest":0,"note":"Its matter set as dots on a ball seen from the side, this many rows from pole to pole, with a few grains in orbit: 0 flat, 9 an orb."},"spin":{"min":-3,"max":3,"rest":0,"note":"How fast a globe turns, in turns a second. What it has turned is kept, so a change of speed never jumps it."},"stir":{"min":0,"max":1,"rest":0,"note":"How much a globe is stirred: its rows slide past each other, its axis wanders and its orbits quicken."},"loose":{"min":0,"max":1,"rest":0,"note":"How far a globe has lost its shape: 0 a ball, 1 a lump that bulges, its dots frayed and some of its matter strayed."},"turn":{"min":-180,"max":180,"rest":0,"note":"Rotation in degrees, mirrored across the face."},"scale":{"min":0,"max":3,"rest":1,"note":"Size of the whole feature."},"alpha":{"min":0,"max":1,"rest":1,"note":"How bright its matter is."},"share":{"min":0,"max":4,"rest":1,"note":"Its share of the matter; matter flows between features as shares change."}},"faceChannels":{"face.tilt":{"min":-40,"max":40,"rest":0,"note":"Head tilt in degrees."},"face.scale":{"min":0.5,"max":1.6,"rest":1,"note":"Head size."},"face.dx":{"min":-40,"max":40,"rest":0,"note":"Head shift sideways, face units."},"face.dy":{"min":-40,"max":40,"rest":0,"note":"Head shift; negative is up."},"face.squash":{"min":-0.4,"max":0.4,"rest":0,"note":"Positive squashes flat and wide, negative stretches tall."},"gaze.x":{"min":-1,"max":1,"rest":0,"note":"Where it looks: -1 left, 1 right."},"gaze.y":{"min":-1,"max":1,"rest":0,"note":"Where it looks: -1 up, 1 down."},"matter.cohesion":{"min":0,"max":1,"rest":0.82,"note":"How tightly matter holds its shape: 1 crisp, 0 a loose cloud."},"matter.jitter":{"min":0,"max":1,"rest":0.06,"note":"Fast tremble."},"matter.drift":{"min":0,"max":1,"rest":0.12,"note":"Slow wander."},"matter.size":{"min":0.4,"max":2.5,"rest":1,"note":"Grain size."},"matter.glow":{"min":0,"max":1.5,"rest":1,"note":"Brightness."},"matter.hue":{"min":-180,"max":180,"rest":0,"note":"Colour, in degrees away from its own."},"emit.left":{"min":0,"max":1,"rest":0,"note":"Arcs leaving the left side of the face, as sound leaves a loudspeaker: 0 none, 1 all of them."},"emit.right":{"min":0,"max":1,"rest":0,"note":"Arcs leaving the right side."},"auto.blink":{"min":0,"max":3,"rest":1,"note":"How often it blinks unasked; 0 never."},"auto.saccade":{"min":0,"max":3,"rest":1,"note":"How much its gaze flicks unasked."},"auto.breath":{"min":0,"max":3,"rest":1,"note":"How deeply it breathes."}},"signals":{"sound.level":{"min":0,"max":1,"note":"How loud what the page is playing is, now. 0 while nothing plays."},"sound.low":{"min":0,"max":1,"note":"The low end of it: the body of a voice, a bass."},"sound.mid":{"min":0,"max":1,"note":"The middle of it: vowels, most of a voice."},"sound.high":{"min":0,"max":1,"note":"The top of it: consonants, hiss."},"sound.beat":{"min":0,"max":1,"note":"Jumps to 1 when a sound sets in (a syllable, a beat) and dies away in about a fifth of a second."},"run.pace":{"min":0,"max":1,"note":"How busy the run is with tools: each call that starts or ends pushes it up, and it dies away in a few seconds. 0 while nothing runs."},"run.effort":{"min":0,"max":1,"note":"The reasoning effort the run was asked for, least 0 to most 1, the middle where none was. 0 while nothing runs.","steady":true},"run.context":{"min":0,"max":1,"note":"How full the conversation is past 400,000 tokens: 0 up to there, 1 at the model's window (a million where it is not known). 0 while nothing runs, and where the window is no larger than that.","steady":true},"body.speed":{"min":0,"max":1,"note":"How fast the figure is moving on the page: 0 still, 1 as fast as it is thrown."}},"book":[{"name":"blink","version":1,"note":"A plain blink.","program":{"steps":[{"op":"to","set":{"eyes.lid":1},"over":70,"hold":45},{"op":"release","channels":["eyes.lid"],"over":130}]},"by":"theo"},{"name":"wink","version":1,"note":"One eye shuts, with a tilt of the head.","program":{"steps":[{"op":"to","set":{"eye.left.lid":1,"eye.left.lowBow":0.5,"face.tilt":-6},"over":110,"hold":260}]},"by":"theo"},{"name":"nod","version":1,"note":"Yes: the head dips twice.","program":{"steps":[{"op":"repeat","times":2,"step":{"op":"seq","steps":[{"op":"to","set":{"face.dy":5,"eyes.lid":0.25},"over":120},{"op":"to","set":{"face.dy":-1.5,"eyes.lid":0},"over":140,"bounce":0.3}]}}]},"by":"theo"},{"name":"shake","version":1,"note":"No: the head turns side to side.","program":{"steps":[{"op":"par","steps":[{"op":"wave","channel":"face.dx","amp":5,"period":240,"for":720},{"op":"wave","channel":"gaze.x","amp":0.35,"period":240,"for":720},{"op":"to","set":{"eyes.lid":0.2},"over":120,"hold":600}]}]},"by":"theo"},{"name":"perk","version":1,"note":"Alert: the eyes open tall and the head lifts.","program":{"steps":[{"op":"to","set":{"eyes.h":15.5,"eyes.w":12.6,"face.dy":-3},"over":160,"bounce":0.5,"hold":520}]},"by":"theo"},{"name":"squint","version":1,"note":"Narrowed eyes: doubt, or looking closely.","program":{"steps":[{"op":"to","set":{"eyes.lid":0.38,"eyes.low":0.3},"over":200,"hold":800}]},"by":"theo"},{"name":"glare","version":1,"note":"Slanted lids: cross, or bearing down on something.","program":{"steps":[{"op":"to","set":{"eyes.lidTilt":0.75,"eyes.lid":0.16,"face.dy":1.5},"over":170,"hold":950}]},"by":"theo"},{"name":"worry","version":1,"note":"Lids slanting outward and down: concern.","program":{"steps":[{"op":"to","set":{"eyes.lidTilt":-0.62,"eyes.h":12,"face.dy":2,"face.tilt":4},"over":260,"hold":900}]},"by":"theo"},{"name":"happy","version":1,"note":"Smiling eyes: the lower lids rise into arcs.","program":{"steps":[{"op":"to","set":{"eyes.lowBow":0.95,"eyes.low":0.22,"face.dy":-2},"over":190,"bounce":0.4,"hold":900}]},"by":"theo"},{"name":"joy","version":1,"note":"Smiling eyes and a little bounce.","program":{"steps":[{"op":"par","steps":[{"op":"use","name":"happy"},{"op":"wave","channel":"face.dy","amp":2.6,"period":270,"for":810}]}]},"by":"theo"},{"name":"think","version":1,"note":"Looking up and away with one eye narrowed.","program":{"steps":[{"op":"par","steps":[{"op":"look","at":{"x":0.55,"y":-0.6},"over":320,"hold":1200},{"op":"to","set":{"eye.left.lid":0.34,"face.tilt":7},"over":320,"hold":1200}]}]},"by":"theo"},{"name":"curious","version":1,"note":"A tilted head, one eye taller than the other.","program":{"steps":[{"op":"to","set":{"face.tilt":-10,"eye.right.h":15.6,"eye.left.h":11.6},"over":240,"bounce":0.35,"hold":900}]},"by":"theo"},{"name":"startle","version":1,"note":"A jump: the eyes go wide and round and the matter scatters.","program":{"steps":[{"op":"burst","strength":{"arg":"kick","or":90}},{"op":"to","set":{"eyes.h":16.5,"eyes.w":13.6,"eyes.round":2.6,"face.scale":1.08,"matter.jitter":0.3},"over":90,"bounce":0.6,"hold":300}]},"by":"theo"},{"name":"wince","version":1,"note":"Eyes screwed shut for a moment.","program":{"steps":[{"op":"to","set":{"eyes.lid":0.8,"eyes.lidTilt":0.5,"face.squash":0.12},"over":90,"hold":320}]},"by":"theo"},{"name":"dizzy","version":1,"note":"Ring eyes and a wobbling head.","program":{"steps":[{"op":"par","steps":[{"op":"to","set":{"eyes.hollow":0.72,"eyes.round":2,"eyes.w":12.5,"eyes.h":12.5},"over":200,"hold":1300},{"op":"wave","channel":"face.tilt","amp":9,"period":700,"for":1500},{"op":"wave","channel":"gaze.x","amp":0.5,"period":500,"for":1500},{"op":"wave","channel":"gaze.y","amp":0.5,"period":500,"for":1500}]}]},"by":"theo"},{"name":"sigh","version":1,"note":"The lids and head sink, then come back slowly.","program":{"steps":[{"op":"to","set":{"eyes.lid":0.5,"face.dy":3.5,"matter.glow":0.8},"over":520,"hold":520},{"op":"release","over":700}]},"by":"theo"},{"name":"scan","version":1,"note":"The gaze sweeps across, as if reading.","program":{"steps":[{"op":"par","steps":[{"op":"wave","channel":"gaze.x","amp":0.7,"period":950,"for":1900},{"op":"to","set":{"eyes.lid":0.2,"gaze.y":0.25},"over":200,"hold":1700}]}]},"by":"theo"},{"name":"visit","version":1,"note":"Goes to the artifact in view: looks at it, travels to its side, and looks it over.","program":{"steps":[{"op":"look","at":"artifact","over":240,"hold":220},{"op":"go","to":"artifact","size":1.8,"over":700},{"op":"wait","ms":950},{"op":"par","steps":[{"op":"look","at":"artifact","over":220},{"op":"to","set":{"face.tilt":-7,"eye.right.h":15,"eye.left.h":12},"over":240,"bounce":0.3,"hold":1300}]}]},"by":"theo"},{"name":"melt","version":1,"note":"The matter lets go of its shape and sags.","program":{"steps":[{"op":"to","set":{"matter.cohesion":0.12,"matter.drift":0.8,"eyes.y":7,"eyes.h":10},"over":600,"hold":900}]},"by":"theo"},{"name":"sparkle","version":1,"note":"A shimmer through the matter.","program":{"steps":[{"op":"par","steps":[{"op":"wave","channel":"matter.glow","amp":0.3,"period":180,"for":900},{"op":"wave","channel":"matter.size","amp":0.35,"period":230,"for":900,"shape":"noise"},{"op":"to","set":{"matter.jitter":0.35},"over":120,"hold":780}]}]},"by":"theo"},{"name":"skeptic","version":1,"note":"One brow up. The brows are features this performance adds: nothing about the face had them before.","program":{"steps":[{"op":"par","steps":[{"op":"feature","id":"brow.left","set":{"w":11,"h":1.7,"y":-20,"x":20,"round":6,"share":0.3,"turn":-8}},{"op":"feature","id":"brow.right","set":{"w":11,"h":1.7,"y":-20,"x":20,"round":6,"share":0.3,"turn":4}},{"op":"to","set":{"eyes.h":10.5,"eyes.y":4},"over":220}]},{"op":"to","set":{"brow.left.y":-24,"brow.left.turn":-16,"eye.right.lid":0.3,"face.tilt":-5},"over":260,"bounce":0.4,"hold":1100}]},"by":"theo"},{"name":"attend","version":1,"note":"Listening to the person: open eyes turned to where they type.","program":{"keep":true,"steps":[{"op":"par","steps":[{"op":"to","set":{"eyes.h":14.2},"over":220},{"op":"look","at":"composer","over":260}]}]},"by":"theo"},{"name":"focus","version":1,"note":"Working: lowered lids, a busy gaze, tight matter.","program":{"keep":true,"steps":[{"op":"to","set":{"eyes.lid":0.24,"eyes.low":0.1,"gaze.y":0.22,"auto.saccade":1.9,"auto.blink":0.7,"matter.cohesion":0.92},"over":320}]},"by":"theo"},{"name":"ask","version":1,"note":"Waiting on the person: wide eyes and a tilted head, looking at them.","program":{"keep":true,"steps":[{"op":"par","steps":[{"op":"to","set":{"eyes.h":15.2,"eyes.round":3.2,"face.tilt":8},"over":260,"bounce":0.4},{"op":"look","at":"person","over":260}]}]},"by":"theo"},{"name":"sleep","version":1,"note":"Asleep: shut eyes, dim, breathing slowly.","program":{"keep":true,"steps":[{"op":"to","set":{"eyes.lid":0.55,"face.dy":2},"over":700,"hold":500},{"op":"to","set":{"eyes.lid":1,"face.dy":3.5,"face.tilt":5,"matter.glow":0.5,"matter.drift":0.05,"auto.blink":0,"auto.saccade":0,"auto.breath":1.9},"over":900}]},"by":"theo"},{"name":"wake","version":1,"note":"Waking: a slow half-open, a blink, then alert.","program":{"steps":[{"op":"to","set":{"eyes.lid":0.6},"over":320,"hold":220},{"op":"use","name":"blink"},{"op":"use","name":"perk","intensity":0.7}]},"by":"theo"},{"name":"done","version":1,"note":"Finished: smiling eyes and a nod.","program":{"steps":[{"op":"par","steps":[{"op":"use","name":"happy"},{"op":"use","name":"nod"}]}]},"by":"theo"},{"name":"orb","version":1,"note":"While the agent works: the eyes give their matter to one ball of dots that turns, with a few grains in orbit. It turns faster and is stirred more with each tool call, is larger the harder the run was asked to think, and loses its shape as the conversation fills past 400,000 tokens.","program":{"keep":true,"steps":[{"op":"par","steps":[{"op":"feature","id":"orb","side":"centre","set":{"x":0,"y":0,"w":14,"h":14,"round":2,"globe":9,"spin":0.11,"stir":0.14,"scale":0.76,"alpha":0.45,"share":1}},{"op":"to","set":{"eyes.share":0,"eyes.lid":0,"eyes.low":0,"gaze.x":0,"gaze.y":0,"matter.cohesion":0.9,"matter.drift":0.02,"auto.blink":0,"auto.saccade":0},"over":420,"bounce":0.2},{"op":"follow","channel":"orb.spin","signal":"run.pace","amp":0.7},{"op":"follow","channel":"orb.stir","signal":"run.pace","amp":0.8},{"op":"follow","channel":"orb.scale","signal":"run.effort","amp":0.54},{"op":"follow","channel":"orb.loose","signal":"run.context","amp":1}]}]},"by":"theo"},{"name":"boombox","version":1,"note":"While sound plays: the eyes become the mesh covers of two loudspeakers that throb with it, a tuner opens above and between them, and arcs leave its sides.","program":{"keep":true,"steps":[{"op":"par","steps":[{"op":"feature","id":"dial","side":"centre","set":{"x":0,"y":-12,"w":2.6,"h":10,"turn":90,"round":8,"slats":7,"share":0.24}},{"op":"to","set":{"eyes.x":27,"eyes.y":3,"eyes.w":13,"eyes.h":13,"eyes.round":2,"eyes.mesh":10,"eyes.lid":0,"eyes.low":0,"eyes.lidTilt":0,"eyes.lowBow":0,"gaze.x":0,"gaze.y":0,"matter.cohesion":0.96,"matter.drift":0.03,"matter.size":0.5,"matter.glow":1.35,"auto.blink":0,"auto.saccade":0},"over":340,"bounce":0.3},{"op":"follow","channel":"eyes.scale","signal":"sound.low","amp":0.14},{"op":"follow","channel":"eyes.scale","signal":"sound.beat","amp":0.07},{"op":"follow","channel":"dial.h","signal":"sound.high","amp":2.4},{"op":"follow","channel":"emit.left","signal":"sound.level","amp":1},{"op":"follow","channel":"emit.right","signal":"sound.level","amp":1}]}]},"by":"theo"},{"name":"speak","version":1,"note":"While sound plays: a mouth that opens as far as the sound is loud. The mouth is a feature this adds.","program":{"keep":true,"steps":[{"op":"par","steps":[{"op":"feature","id":"mouth","side":"centre","set":{"x":0,"y":19,"w":6.5,"h":0.9,"round":2.4,"share":0.3}},{"op":"to","set":{"eyes.y":-5,"eyes.h":11.5},"over":260},{"op":"follow","channel":"mouth.h","signal":"sound.level","amp":6},{"op":"follow","channel":"mouth.w","signal":"sound.mid","amp":-1.6},{"op":"follow","channel":"face.dy","signal":"sound.beat","amp":-0.8}]}]},"by":"theo"},{"name":"thump","version":1,"note":"A jolt through the whole face, as at a loud sound.","program":{"steps":[{"op":"burst","strength":{"arg":"kick","or":50}},{"op":"to","set":{"face.scale":1.12,"face.squash":-0.06,"matter.jitter":0.3},"over":70,"bounce":0.6,"hold":160}]},"by":"theo"}],"rules":[{"id":"poke-startle","on":"person.poke","do":"startle","by":"theo","when":{"streak":[1,1]},"weight":2},{"id":"poke-perk","on":"person.poke","do":"perk","by":"theo","when":{"streak":[1,2]}},{"id":"poke-curious","on":"person.poke","do":"curious","by":"theo","when":{"streak":[1,3]}},{"id":"poke-squint","on":"person.poke","do":"squint","by":"theo","when":{"streak":[2,4]},"weight":2},{"id":"poke-wince","on":"person.poke","do":"wince","by":"theo","when":{"streak":[2,5]}},{"id":"poke-glare","on":"person.poke","do":"glare","by":"theo","when":{"streak":[4,7]},"weight":3},{"id":"poke-shake","on":"person.poke","do":"shake","by":"theo","when":{"streak":[4,8]}},{"id":"poke-dizzy","on":"person.poke","do":"dizzy","by":"theo","when":{"streak":[7,999]},"weight":3},{"id":"poke-melt","on":"person.poke","do":"melt","by":"theo","when":{"streak":[8,999]}},{"id":"poke-sigh","on":"person.poke","do":"sigh","by":"theo","when":{"streak":[6,999]}},{"id":"pet-happy","on":"person.pet","do":"happy","by":"theo","weight":2},{"id":"pet-joy","on":"person.pet","do":"joy","by":"theo","when":{"streak":[2,999]},"weight":2},{"id":"pet-sparkle","on":"person.pet","do":"sparkle","by":"theo","when":{"valence":[0.3,1]}},{"id":"pet-wink","on":"person.pet","do":"wink","by":"theo","when":{"habit":[0.2,1]}},{"id":"drop-shake","on":"person.drop","do":"shake","by":"theo","weight":2},{"id":"drop-dizzy","on":"person.drop","do":"dizzy","by":"theo","when":{"fast":[3,999]},"weight":3},{"id":"drop-perk","on":"person.drop","do":"perk","by":"theo"},{"id":"throw-startle","on":"person.throw","do":"startle","by":"theo","when":{"streak":[1,1]},"weight":2},{"id":"throw-perk","on":"person.throw","do":"perk","by":"theo"},{"id":"throw-joy","on":"person.throw","do":"joy","by":"theo","when":{"valence":[0.25,1]},"weight":2},{"id":"throw-dizzy","on":"person.throw","do":"dizzy","by":"theo","when":{"fast":[3,999]},"weight":3},{"id":"bump-wince","on":"body.bump.*","do":"wince","by":"theo","weight":2,"cooldown":900},{"id":"bump-squint","on":"body.bump.*","do":"squint","by":"theo","when":{"arousal":[0,0.5]},"intensity":0.7,"cooldown":900},{"id":"bump-glare","on":"body.bump.*","do":"glare","by":"theo","when":{"arousal":[0.55,1],"valence":[-1,0.1]},"weight":2,"cooldown":2000},{"id":"bump-dizzy","on":"body.bump.*","do":"dizzy","by":"theo","when":{"arousal":[0.7,1]},"weight":2,"cooldown":4000},{"id":"meet-startle","on":"body.meet.kit","do":"startle","by":"theo","weight":2,"cooldown":900},{"id":"meet-wince","on":"body.meet.kit","do":"wince","by":"theo","cooldown":900},{"id":"meet-curious","on":"body.meet.kit","do":"curious","by":"theo","when":{"arousal":[0,0.6]},"cooldown":1500},{"id":"meet-wink","on":"body.meet.kit","do":"wink","by":"theo","when":{"valence":[0.2,1]},"weight":2,"cooldown":3000},{"id":"meet-dizzy","on":"body.meet.kit","do":"dizzy","by":"theo","when":{"streak":[3,999]},"weight":3,"cooldown":4000},{"id":"send-perk","on":"person.send","do":"perk","by":"theo","intensity":0.7},{"id":"send-nod","on":"person.send","do":"nod","by":"theo","intensity":0.8},{"id":"send-flurry","on":"person.send","do":"startle","by":"theo","when":{"fast":[3,999]},"intensity":0.6,"weight":2},{"id":"return-wake","on":"person.return","do":"perk","by":"theo","cooldown":60000},{"id":"return-wink","on":"person.return","do":"wink","by":"theo","cooldown":120000,"weight":0.5},{"id":"tool-scan","on":"run.tool","do":"scan","by":"theo","when":{"streak":[4,999]},"cooldown":12000},{"id":"tool-curious","on":"run.tool","do":"curious","by":"theo","when":{"novelty":[0.7,1]},"cooldown":20000,"weight":0.6},{"id":"fail-wince","on":"run.tool.fail","do":"wince","by":"theo","when":{"streak":[1,1]},"weight":2},{"id":"fail-worry","on":"run.tool.fail","do":"worry","by":"theo","when":{"fast":[1.5,999]},"weight":2},{"id":"fail-glare","on":"run.tool.fail","do":"glare","by":"theo","when":{"fast":[3,999]},"weight":3},{"id":"error-worry","on":"run.error","do":"worry","by":"theo","weight":2},{"id":"error-sigh","on":"run.error","do":"sigh","by":"theo"},{"id":"done-done","on":"run.done","do":"done","by":"theo","weight":3},{"id":"done-joy","on":"run.done","do":"joy","by":"theo","when":{"valence":[0.3,1]},"weight":2},{"id":"done-relief","on":["run.tool.fail","run.done"],"do":"sigh","by":"theo","within":120000,"weight":4,"note":"Finished right after a failure: relief, not cheer."},{"id":"done-wink","on":"run.done","do":"wink","by":"theo","when":{"habit":[0.5,1]}},{"id":"work-orb","on":"run.work","do":"orb","by":"theo","until":"run.rest","note":"While the agent works, the face is a thinking orb."},{"id":"sound-boombox","on":"sound.start","do":"boombox","by":"theo","until":"sound.stop","weight":3,"note":"What plays aloud is shown as a loudspeaker."},{"id":"sound-speak","on":"sound.start","do":"speak","by":"theo","until":"sound.stop","note":"Or as a mouth, now and then."},{"id":"sound-thump","on":"sound.loud","do":"thump","by":"theo","cooldown":3000},{"id":"resize-startle","on":"env.resize","do":"startle","by":"theo","when":{"streak":[1,1]},"intensity":0.5,"cooldown":8000},{"id":"resize-wince","on":"env.resize","do":"wince","by":"theo","when":{"streak":[3,999]},"cooldown":6000},{"id":"theme-sparkle","on":"env.theme","do":"sparkle","by":"theo","weight":2},{"id":"theme-perk","on":"env.theme","do":"perk","by":"theo"},{"id":"offline-worry","on":"env.offline","do":"worry","by":"theo","weight":3},{"id":"online-happy","on":"env.online","do":"happy","by":"theo","weight":3},{"id":"copy-wink","on":"env.copy","do":"wink","by":"theo","weight":0.3,"cooldown":30000}]}
