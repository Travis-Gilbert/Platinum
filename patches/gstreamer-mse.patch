@@ -1471,6 +1471,39 @@ GST_START_TEST (test_parse_aud_insert)

 GST_END_TEST;

+GST_START_TEST (test_parse_stale_container_dimensions)
+{
+  GstHarness *h = gst_harness_new ("h264parse");
+  GstBuffer *buf;
+  GstCaps *caps;
+  GstStructure *s;
+  gsize offset = 0;
+
+  /* An MP4 demuxer can retain its initial width/height after an in-band
+   * SPS change. The output must describe the parsed image, not the stale
+   * container dimensions, including the SPS cropping rectangle. */
+  gst_harness_set_caps_str (h,
+      "video/x-h264, stream-format=byte-stream, alignment=au, width=400, height=300",
+      "video/x-h264, stream-format=avc, alignment=au");
+  buf = gst_buffer_new_and_alloc (sizeof (h264_sps) + sizeof (h264_pps) +
+      sizeof (h264_idrframe));
+  offset += gst_buffer_fill (buf, offset, h264_sps, sizeof (h264_sps));
+  offset += gst_buffer_fill (buf, offset, h264_pps, sizeof (h264_pps));
+  gst_buffer_fill (buf, offset, h264_idrframe, sizeof (h264_idrframe));
+  buf = gst_harness_push_and_pull (h, buf);
+  fail_unless (buf != NULL);
+  gst_buffer_unref (buf);
+  caps = gst_pad_get_current_caps (h->sinkpad);
+  fail_unless (caps != NULL);
+  s = gst_caps_get_structure (caps, 0);
+  fail_unless_structure_field_int_equals (s, "width", 32);
+  fail_unless_structure_field_int_equals (s, "height", 24);
+  gst_caps_unref (caps);
+  gst_harness_teardown (h);
+}
+
+GST_END_TEST;
+
