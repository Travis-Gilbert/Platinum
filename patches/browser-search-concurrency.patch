+    /// Retain a completed query under the store lock. Completion order is used
+    /// for the bounded session cache; a result from another store is refused.
+    pub fn finish_programmable_search(
+        &mut self,
+        completed: CompletedBrowserSearch,
+    ) -> GraphStoreResult<SearchSession> {
+        if !Arc::ptr_eq(&completed.owner, &self.search.owner) {
+            return Err(error("search belongs to a different browser store"));
+        }
+        let session = completed.session;
         session.persist(&mut self.store)?;
         self.search.sessions.push_back(session.clone());
         // Ephemeral UI state is bounded and never implicitly admitted to My Web.
