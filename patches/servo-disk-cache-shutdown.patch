+    /// Preserve completed memory entries before acknowledging orderly shutdown.
+    /// Eviction writes alone lose the hot working set on a browser restart.
+    pub(crate) async fn flush_to_disk(&self) {
+        let Some(disk_cache) = &self.disk_cache else {
+            return;
+        };
+        for (key, entry) in self.entries.iter() {
+            // A request still holding this entry must not block shutdown.
+            let snapshot = {
+                let Ok(resources) = entry.try_read() else {
+                    continue;
+                };
+                let completed = resources
+                    .iter()
+                    .filter(|resource| resource.is_done())
+                    .cloned()
+                    .collect::<Vec<_>>();
+                if completed.is_empty() {
+                    continue;
+                }
+                StdArc::new(TokioRwLock::new(completed))
+            };
+            disk_cache.store(key, snapshot).await;
+        }
+    }
+
     /// Clear the contents of this cache.
     pub(crate) fn clear(&self) {
         self.entries.clear();
