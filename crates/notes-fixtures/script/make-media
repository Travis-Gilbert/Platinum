#!/usr/bin/env bash
# Regenerates the binary attachments of the fixture vault from tools on the
# machine (ffmpeg, cwebp, avifenc, cupsfilter). Nothing is downloaded and no
# existing media is used: every image, sound and clip is synthesised from
# ffmpeg's test sources, and the PDF is typeset from text.
#
# The output is committed; run this only to change the attachments, and keep
# the file names, which the fixture notes embed.
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
out="$here/vault/attachments"
mkdir -p "$out"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# ff <input options and -i inputs> -- <output options and file>: the
# bit-exact flags are output options, so they go between the two halves.
ff() {
  local in=()
  while [[ "$1" != "--" ]]; do in+=("$1"); shift; done
  shift
  ffmpeg -hide_banner -loglevel error -y "${in[@]}" -fflags +bitexact -flags:v +bitexact -flags:a +bitexact -map_metadata -1 "$@"
}

# Images (formats Obsidian embeds: avif bmp gif jpeg jpg png svg webp).
ff -f lavfi -i "testsrc=size=64x48:rate=1:duration=1" -- -frames:v 1 "$out/pixel.png"
ff -f lavfi -i "smptebars=size=160x90:rate=1:duration=1" -- -frames:v 1 "$out/wide.png"
ff -f lavfi -i "testsrc2=size=96x64:rate=1:duration=1" -- -frames:v 1 -q:v 5 "$out/photo.jpg"
ff -f lavfi -i "testsrc=size=32x32:rate=4:duration=1" -- "$out/anim.gif"
ff -f lavfi -i "testsrc=size=16x16:rate=1:duration=1" -- -frames:v 1 -pix_fmt bgr24 "$out/icon.bmp"
ff -f lavfi -i "gradients=size=64x48:rate=1:duration=1:seed=7" -- -frames:v 1 "$out/unused.png"
ff -f lavfi -i "testsrc2=size=48x48:rate=1:duration=1" -- -frames:v 1 "$out/Pasted image 20261024101500.png"
cwebp -quiet -q 60 "$out/pixel.png" -o "$out/pic.webp"
avifenc --speed 8 -q 44 "$out/pixel.png" "$out/pic.avif" >/dev/null

# Audio: half a second of A4.
tone=(-f lavfi -i "sine=frequency=440:duration=0.5")
ff "${tone[@]}" -- -ac 1 -ar 8000 -c:a pcm_s16le "$out/tone.wav"
ff "${tone[@]}" -- -ac 1 -ar 22050 -c:a libmp3lame -b:a 32k "$out/tone.mp3"
ff "${tone[@]}" -- -ac 1 -ar 22050 -c:a aac -b:a 32k "$out/tone.m4a"
ff "${tone[@]}" -- -ac 1 -ar 48000 -c:a libopus -b:a 24k "$out/tone.ogg"

# Video: half a second of a test card with the tone.
card=(-f lavfi -i "testsrc=size=64x48:rate=10:duration=0.5" -f lavfi -i "sine=frequency=440:duration=0.5")
ff "${card[@]}" -- -c:v libx264 -preset veryslow -crf 38 -pix_fmt yuv420p -c:a aac -b:a 24k -ar 22050 -ac 1 -movflags +faststart "$out/clip.mp4"
ff "${card[@]}" -- -c:v libvpx -b:v 40k -crf 40 -c:a libopus -b:a 16k -ar 48000 -ac 1 "$out/clip.webm"

# A three-page PDF whose pages say which page they are, so #page=N is visible.
printf 'Frame fixture PDF\nPage 1 of 3\n\f\nPage 2 of 3\n\f\nPage 3 of 3\n' > "$work/sample.txt"
cupsfilter -m application/pdf "$work/sample.txt" > "$out/sample.pdf" 2>/dev/null

ls -l "$out"
