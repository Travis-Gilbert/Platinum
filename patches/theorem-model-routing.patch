+    /// A bounded structured-answer call through the existing provider owner.
+    /// The caller supplies the contract schema and validates the returned JSON.
+    pub fn typed_json(
+        &self,
+        instruction: &str,
+        state: &Value,
+        schema: Value,
+    ) -> Result<(Vec<u8>, zephium_decision::DecisionUsage), super::decision::CallError> {
+        use super::decision::CallError;
+        use std::io::Read;
+        let body = json!({"model": self.config.model, "stream": false,
+            "messages": [{"role":"system","content":instruction},{"role":"user","content":state.to_string()}],
+            "max_tokens": self.config.max_tokens,
+            "response_format":{"type":"json_schema","json_schema":{"name":"typed_decision","strict":true,"schema":schema}}});
+        let mut request = self
+            .http
+            .post(chat_completions_url(&self.endpoint()))
+            .json(&body);
+        if let Some(key) = &self.api_key {
+            request = request.bearer_auth(key);
+        }
+        // No automatic retry: a paid call with an unknown outcome is receipted.
+        let response = request
+            .send()
+            .map_err(|_| CallError::UnknownOutcome("decision_unavailable"))?;
+        if !response.status().is_success() {
+            return Err(if response.status().is_client_error() {
+                CallError::Rejected("decision_provider_refused")
+            } else {
+                CallError::UnknownOutcome("decision_provider_unavailable")
+            });
+        }
+        let mut bytes = Vec::new();
+        response
+            .take(zephium_decision::MAX_RESPONSE_BYTES as u64 + 1)
+            .read_to_end(&mut bytes)
+            .map_err(|_| CallError::UnknownOutcome("decision_unavailable"))?;
+        if bytes.len() > zephium_decision::MAX_RESPONSE_BYTES {
+            return Err(CallError::Rejected("decision_response_too_large"));
+        }
+        let value: Value = serde_json::from_slice(&bytes)
+            .map_err(|_| CallError::Rejected("decision_invalid_answer"))?;
+        let choices = value["choices"]
+            .as_array()
+            .filter(|choices| choices.len() == 1)
+            .ok_or(CallError::Rejected("decision_invalid_answer"))?;
+        let choice = &choices[0];
+        if choice["finish_reason"] != "stop"
+            || choice["message"]
+                .get("tool_calls")
+                .is_some_and(|v| !v.is_null())
+        {
+            return Err(CallError::Rejected("decision_invalid_answer"));
+        }
+        let content = choice["message"]["content"]
+            .as_str()
+            .ok_or(CallError::Rejected("decision_invalid_answer"))?;
+        let count = |key: &str| {
+            value["usage"][key]
+                .as_u64()
+                .and_then(|n| u32::try_from(n).ok())
+                .ok_or(CallError::Rejected("decision_usage_missing"))
+        };
+        Ok((
+            content.as_bytes().to_vec(),
+            zephium_decision::DecisionUsage {
+                input_tokens: count("prompt_tokens")?,
+                output_tokens: count("completion_tokens")?,
+            },
+        ))
+    }
