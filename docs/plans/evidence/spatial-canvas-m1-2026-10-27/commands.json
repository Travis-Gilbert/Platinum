    "stdin": "\n  document.cookie = 'frame_canvas_session=m1; SameSite=Lax; Path=/';\n  const state = window.canvasInput = {clicks: 0, hovers: 0, drag: null, wheel: 0, choice: 'First', dialogs: [], escape: 0, space: 0};\n  const target = document.querySelector('#target');\n  target.addEventListener('click', e => { state.clicks++; state.click = [e.clientX, e.clientY]; });\n  target.addEventListener('pointerenter', () => state.hovers++);\n  const drag = document.querySelector('#drag');\n  drag.addEventListener('pointerdown', e => { drag.setPointerCapture(e.pointerId); state.drag = {start: [e.clientX, e.clientY], end: null}; });\n  drag.addEventListener('pointerup', e => { if (state.drag) state.drag.end = [e.clientX, e.clientY]; });\n  document.querySelector('#scroller').addEventListener('scroll', e => state.wheel = e.target.scrollTop);\n  document.querySelector('#choice').addEventListener('change', e => state.choice = e.target.value);\n  for (const kind of ['alert', 'confirm', 'prompt']) {\n    document.querySelector('#' + kind).addEventListener('click', () => {\n      setTimeout(() => state.dialogs.push({kind, response: window[kind]('Canvas ' + kind)}), 250);\n    });\n  }\n  addEventListener('keydown', e => {\n    if (e.key === ' ') state.space++;\n    if (e.key === 'Escape') {\n      state.escape++;\n      if (document.querySelector('#consumeEscape').checked) e.preventDefault();\n    }\n  });\n"
