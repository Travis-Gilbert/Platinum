+            .recv()
+            .unwrap()
+            .unwrap();
+        let (path, created) = proxy
+            .handle
+            .create_database(proxy.bottle_id, "same-idb".into())
+            .recv()
+            .unwrap()
+            .unwrap();
+        assert!(created);
+        assert!(path.starts_with(roots[index].path()));
+        paths.push(path);
