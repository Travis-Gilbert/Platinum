#!/usr/bin/env python3
"""Prepare the pinned Servo/GStreamer MSE development dependencies.

Does not replace existing changes. Run script/bootstrap first to select deps/.
Requires git, pkg-config, Homebrew GStreamer, Meson and Ninja.
"""
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent


def run(*args, cwd=None):
    subprocess.run(args, cwd=cwd, check=True)


def checkout(name, url, revision, patch=None, sparse=False):
    path = ROOT / "deps" / name
    if not path.exists():
        run("git", "clone", "--filter=blob:none", "--no-checkout", url, str(path))
        if sparse:
            run("git", "sparse-checkout", "set", "subprojects/gst-plugins-bad", "subprojects/packagefiles", cwd=path)
        run("git", "checkout", "--detach", revision, cwd=path)
    actual = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=path, text=True).strip()
    if actual != revision:
        raise RuntimeError(f"{path} is at {actual}; expected {revision}")
    if patch is None:
        return path
    patch = str(ROOT / "patches" / patch)
    if subprocess.run(["git", "apply", "--reverse", "--check", patch], cwd=path,
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        run("git", "apply", "--check", patch, cwd=path)
        run("git", "apply", patch, cwd=path)
    return path


def main():
    (ROOT / "deps").mkdir(exist_ok=True)
    checkout("servo-mse", "https://github.com/Travis-Gilbert/servo.git",
             "0ea861a20ac9e81c67dd2106322e7e4775e4e824")
    source = checkout("gstreamer-mse", "https://github.com/GStreamer/gstreamer.git",
                      "1b2a95a1b72787cda146b46df9605b168e5b683b", "gstreamer-mse.patch", sparse=True)
    build = ROOT / "deps/gstreamer-mse-build"
    prefix = (ROOT / "deps").resolve() / "gstreamer-mse-runtime"
    args = ["meson", "setup"]
    if (build / "meson-private/coredata.dat").exists():
        args.append("--reconfigure")
    run(*args, str(build), str(source / "subprojects/gst-plugins-bad"),
        f"--prefix={prefix}", "-Dauto_features=disabled", "-Dmse=enabled",
        "-Dtests=disabled", "-Dexamples=disabled", "-Dintrospection=disabled")
    run("ninja", "-C", str(build))
    run("meson", "install", "-C", str(build))
    print("Ready: script/media-env cargo build --locked")


if __name__ == "__main__":
    main()
