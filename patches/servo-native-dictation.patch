+// Use DOM Range's own text projection for offsets. No HTML parser or script
+// mutation: selection and composition remain with Servo's editing owner.
+fn editable_host(window: &Window) -> Option<DomRoot<Node>> {
+    let document = window.Document();
+    let area = document.focus_handler().focused_area();
+    let element = area.element()?;
+    if element.is::<HTMLInputElement>() || element.is::<HTMLTextAreaElement>() {
+        return None;
+    }
+    element.upcast::<Node>().editing_host_of()
+}
+fn editable_snapshot(window: &Window, cx: &mut JSContext) -> Option<(String, (u32, u32))> {
+    let host = editable_host(window)?;
+    let document = window.Document();
+    let selection = document.selection()?;
+    let range = selection.active_range(cx)?;
+    if range.start_container().editing_host_of().as_ref() != Some(&host)
+        || range.end_container().editing_host_of().as_ref() != Some(&host)
+    {
+        return None;
+    }
+    // Non-editable islands have a separate authority. Do not flatten offsets
+    // across them or a nested editing host.
+    let mut text = String::new();
+    for node in host.traverse_preorder(ShadowIncluding::No) {
+        if node.editing_host_of().as_ref() != Some(&host)
+            || node.is::<HTMLInputElement>()
+            || node.is::<HTMLTextAreaElement>()
+        {
+            return None;
+        }
+        if let Some(node) = node.downcast::<Text>() {
+            let data = node.upcast::<CharacterData>().data();
+            if text.len().saturating_add(data.len()) > 65536 {
+                return None;
+            }
+            text.push_str(&data);
+        }
+    }
+    let prefix = Range::new(
+        cx,
+        &document,
+        &host,
+        0,
+        &range.start_container(),
+        range.start_offset(),
+    );
+    let start = prefix.Stringifier(cx).len_utf16().0;
+    prefix
+        .SetEnd(cx, &range.end_container(), range.end_offset())
+        .ok()?;
+    let end = prefix.Stringifier(cx).len_utf16().0;
+    Some((text, (start, end)))
+}
+fn editable_select(
+    window: &Window,
+    range: (u32, u32),
+    cx: &mut JSContext,
+) -> Result<(), NativeTextError> {
+    let host = editable_host(window).ok_or(NativeTextError::Unsupported)?;
+    let position = |offset: u32| -> Option<(DomRoot<Node>, u32)> {
+        let mut remaining = offset;
+        for node in host.traverse_preorder(ShadowIncluding::No) {
+            if let Some(text) = node.downcast::<Text>() {
+                let len = text.upcast::<CharacterData>().data().encode_utf16().count() as u32;
+                if remaining <= len {
+                    return Some((node.clone(), remaining));
+                }
+                remaining -= len;
+            }
+        }
+        (offset == 0).then(|| (host.clone(), 0))
+    };
+    let (start, a) = position(range.0).ok_or(NativeTextError::InvalidRange)?;
+    let (end, b) = position(range.1).ok_or(NativeTextError::InvalidRange)?;
+    window
+        .Document()
+        .selection()
+        .ok_or(NativeTextError::StaleContext)?
+        .SetBaseAndExtent(cx, &start, a, &end, b)
+        .map_err(|_| NativeTextError::EditRefused)
+}
