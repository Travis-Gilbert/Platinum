+
+// https://www.w3.org/TR/media-source-2/#dom-readystate
+enum ReadyState {
+  "closed",
+  "open",
+  "ended",
+};
+
+// https://www.w3.org/TR/media-source-2/#dom-endofstreamerror
+enum EndOfStreamError {
+  "network",
+  "decode",
