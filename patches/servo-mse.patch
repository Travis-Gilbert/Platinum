+            Some(root.to_owned()),
+            false,
+            "partition-test",
+            &StorageEngines::default(),
+        )
+    };
+    let groups = roots.each_ref().map(|root| make_group(root.path()));
+    let mut pending = Vec::new();
+    let mut paths = Vec::new();
